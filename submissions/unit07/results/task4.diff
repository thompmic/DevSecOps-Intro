diff --git a/labs/unit07/edge/nginx.conf b/labs/unit07/edge/nginx.conf
index d7f85fc..1e26900 100644
--- a/labs/unit07/edge/nginx.conf
+++ b/labs/unit07/edge/nginx.conf
@@ -34,6 +34,15 @@ http {
       proxy_read_timeout      10s;
     }
 
+    # Task 4 (Unit 07) — degradation decision.
+    # The product catalogue and the client bootstrap config are anonymous-
+    # readable by design: the identity provider approved them unconditionally.
+    # Gating them bought no access control and cost the entire shop whenever
+    # idp was unavailable (E2: 0% success; E3: 0% plus a 10 s wait per call).
+    # These two routes now fail OPEN; everything else still fails CLOSED.
+    location ^~ /api/Products                        { proxy_pass http://juice; }
+    location = /rest/admin/application-configuration { proxy_pass http://juice; }
+
     location /api/  { auth_request /_auth; proxy_pass http://juice; }
     location /rest/ { auth_request /_auth; proxy_pass http://juice; }
 
